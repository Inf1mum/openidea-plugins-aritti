+// Unknown advisory spellings must not turn into negative call facts.
+func canonicalRustAdvisoryFunction(name string) bool {
+	parts := strings.Split(name, "::")
+	if len(parts) < 2 {
+		return false
+	}
+	for _, part := range parts {
+		if part == "" {
+			return false
+		}
+		for i, c := range part {
+			if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (i > 0 && c >= '0' && c <= '9')) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Preserve every previously admitted legacy spelling alongside canonical aliases.
+func legacyRustSymbols(val string) string {
+	val = cachedregexp.MustCompile(`<[\w,]+>`).ReplaceAllString(val, "")
+	return cachedregexp.MustCompile(`<(.*) as .*>`).ReplaceAllString(val, "$1")
+}
