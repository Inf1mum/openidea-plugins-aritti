+func TestOpenIDEAForLifetimeFunctionArrow(t *testing.T) {
+	input := "<test::bench::Bencher>::bench::<for<'a> fn(&'a mut test::bench::Bencher) -> core::result::Result<(), alloc::string::String>>"
+	if got := cleanRustFunctionSymbols(input); got != "test::bench::Bencher::bench" {
+		t.Fatalf("%q", got)
+	}
+}
+
+func TestOpenIDEAStructuredRustV0GenericSuppression(t *testing.T) {
+	symbol := "_RNvMs7_Cs7hsKmrfQnq6_8smallvecINtB5_8SmallVecAhj1_E4growCs9nebUFs6gOJ_18macho_call_fixture"
+	name, err := demangle.ToString(symbol, demangle.NoClones, demangle.NoTemplateParams)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cleanRustFunctionSymbols(name) != "smallvec::SmallVec::grow" {
+		t.Fatal(name)
+	}
+}
