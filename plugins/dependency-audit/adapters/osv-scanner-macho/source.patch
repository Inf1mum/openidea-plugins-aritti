+// OpenIDEA MachO profile: one adjacent Cargo bundle, bounded UUID matching.
+func functionsFromDWARFPath(readAt io.ReaderAt, path string) (map[string]struct{}, error) {
+	calls, original := functionsFromDWARF(readAt)
+	if original == nil {
+		return calls, nil
+	}
+	mf, err := macho.NewFile(readAt)
+	if err != nil {
+		return nil, original
+	}
+	uuid := machoUUID(mf)
+	if len(uuid) != 16 {
+		return nil, fmt.Errorf("MachO binary UUID missing; analysis unknown")
+	}
+	bundle := path + ".dSYM"
+	info, err := os.Lstat(bundle)
+	if err != nil {
+		return nil, fmt.Errorf("missing adjacent dSYM; analysis unknown: %w", err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		// Cargo links the public executable's bundle to deps/<hashed>.dSYM.
+		target, e := os.Readlink(bundle)
+		if e != nil || filepath.IsAbs(target) || filepath.Dir(target) != "deps" || !strings.HasSuffix(filepath.Base(target), ".dSYM") {
+			return nil, fmt.Errorf("unowned dSYM link; analysis unknown")
+		}
+		depsInfo, depsErr := os.Lstat(filepath.Join(filepath.Dir(path), "deps"))
+		if depsErr != nil || !depsInfo.IsDir() || depsInfo.Mode()&os.ModeSymlink != 0 {
+			return nil, fmt.Errorf("unowned Cargo deps directory; analysis unknown")
+		}
+		bundle = filepath.Join(filepath.Dir(path), target)
+	}
+	for _, part := range []string{bundle, filepath.Join(bundle, "Contents"), filepath.Join(bundle, "Contents/Resources"), filepath.Join(bundle, "Contents/Resources/DWARF")} {
+		info, e := os.Lstat(part)
+		if e != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return nil, fmt.Errorf("invalid dSYM directory; analysis unknown")
+		}
+	}
+	dir := filepath.Join(bundle, "Contents/Resources/DWARF")
+	entries, err := os.ReadDir(dir)
+	if err != nil || len(entries) == 0 || len(entries) > 8 {
+		return nil, fmt.Errorf("missing/oversized dSYM catalog; analysis unknown")
+	}
+	matches := 0
+	var output map[string]struct{}
+	for _, entry := range entries {
+		dsym := filepath.Join(dir, entry.Name())
+		info, err := os.Lstat(dsym)
+		if err != nil || !info.Mode().IsRegular() || info.Size() > 256<<20 {
+			return nil, fmt.Errorf("invalid or oversized dSYM artifact; analysis unknown")
+		}
+		f, err := os.Open(dsym)
+		if err != nil {
+			return nil, err
+		}
+		df, err := macho.NewFile(f)
+		if err != nil {
+			f.Close()
+			return nil, fmt.Errorf("malformed dSYM artifact; analysis unknown: %w", err)
+		}
+		if bytes.Equal(uuid, machoUUID(df)) {
+			matches++
+			dd, e := df.DWARF()
+			if e != nil {
+				f.Close()
+				return nil, fmt.Errorf("invalid dSYM DWARF; analysis unknown: %w", e)
+			}
+			output, e = functionsFromDebugData(dd)
+			if e != nil {
+				f.Close()
+				return nil, e
+			}
+		}
+		f.Close()
+	}
+	if matches != 1 {
+		return nil, fmt.Errorf("expected one UUID-matched dSYM artifact, found %d; analysis unknown", matches)
+	}
+	return output, nil
+}
+func machoUUID(f *macho.File) []byte {
+	if f == nil {
+		return nil
+	}
+	for _, load := range f.Loads {
+		raw := load.Raw()
+		if len(raw) == 24 && f.ByteOrder.Uint32(raw[:4]) == 0x1b && f.ByteOrder.Uint32(raw[4:8]) == 24 {
+			return raw[8:24]
+		}
+	}
+	return nil
 }
 
 func functionsFromDWARF(readAt io.ReaderAt) (map[string]struct{}, error) {
+	file, err := elf.NewFile(readAt)
+	if err != nil {
+		mf, me := macho.NewFile(readAt)
+		if me != nil {
+			return nil, fmt.Errorf("failed to read ELF or MachO binary: %w", err)
+		}
+		dd, de := mf.DWARF()
+		if de != nil {
+			return nil, fmt.Errorf("failed to extract MachO debug symbols: %w", de)
+		}
+		return functionsFromDebugData(dd)
+	}
+	dwarfData, err := file.DWARF()
+	if err != nil {
+		return nil, fmt.Errorf("failed to extract debug symbols from binary: %w", err)
+	}
+	return functionsFromDebugData(dwarfData)
+}
