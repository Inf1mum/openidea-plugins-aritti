+	data, err := dwarf.New(abbrev, nil, nil, info, nil, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := functionsFromDebugData(data); err == nil {
+		t.Fatal("empty function debug admitted")
+	}
+}
+func TestOpenIDEAConservativeNames(t *testing.T) {
+	for input, want := range map[string]string{
+		"<smallvec::SmallVec<[u8; 1]>>::grow":                       "smallvec::SmallVec::grow",
+		"smallvec::SmallVec<A>::grow":                               "smallvec::SmallVec::grow",
+		"<foo::Type<alloc::Vec<u8>> as core::Trait<Other>>::method": "foo::Type::method",
+		"foo::Type<alloc::Vec<[u8; 2]>>::method":                    "foo::Type::method",
+		"foo::Type<A::method":                                       "",
+	} {
+		if got := cleanRustFunctionSymbols(input); got != want {
+			t.Errorf("%q => %q expected%q", input, got, want)
+		}
+	}
+	for _, name := range []string{"x::Type<T>::method", "<x::Type as Trait>::method", "x::method[0]", "x", "x::"} {
+		if canonicalRustAdvisoryFunction(name) {
+			t.Errorf("unsupported advisory admitted:%q", name)
+		}
+	}
+	if !canonicalRustAdvisoryFunction("smallvec::SmallVec::grow") {
+		t.Fatal("plain advisory rejected")
+	}
+}
