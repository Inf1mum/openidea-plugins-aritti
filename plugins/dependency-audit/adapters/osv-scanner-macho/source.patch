+func TestOpenIDEAMalformedBinaryIsUnknown(t *testing.T) {
+	if _, err := functionsFromDWARF(bytes.NewReader([]byte("not executable"))); err == nil {
+		t.Fatal("malformed binary admitted")
+	}
+}
+func TestOpenIDEAMissingDebugIsUnknown(t *testing.T) {
+	binary := os.Getenv("OPENIDEA_MACHO_FIXTURE")
+	if binary == "" {
+		t.Skip("set OPENIDEA_MACHO_FIXTURE to real Rust fixture executable")
+	}
+	data, err := os.ReadFile(binary)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "fixture")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := functionsFromDWARFPath(bytes.NewReader(data), path); err == nil {
+		t.Fatal("missing debug became known")
+	}
+	bundle := path + ".dSYM/Contents/Resources/DWARF"
+	if err := os.MkdirAll(bundle, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(bundle, "fixture"), []byte("malformed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := functionsFromDWARFPath(bytes.NewReader(data), path); err == nil {
+		t.Fatal("malformed debug became known")
+	}
+}
+func TestOpenIDEARealRustSymbols(t *testing.T) {
+	p := os.Getenv("OPENIDEA_MACHO_FIXTURE")
+	if p == "" {
+		t.Skip("fixture unset")
+	}
+	f, e := os.Open(p)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer f.Close()
+	calls, e := functionsFromDWARFPath(f, p)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for name := range calls {
+		if strings.Contains(name, "smallvec") {
+			t.Log(name)
+		}
+	}
+}
+
+func TestOpenIDEARustV0ArrayReceiver(t *testing.T) {
+	for _, name := range []string{"<smallvec::SmallVec<[u8; 1]>>::grow", "smallvec::SmallVec<A>::grow"} {
+		if got := cleanRustFunctionSymbols(name); got != "smallvec::SmallVec::grow" {
+			t.Fatalf("%q => %q", name, got)
+		}
+	}
+}
+
+func TestOpenIDEATruncatedAfterValidSymbolIsUnknown(t *testing.T) {
+	// One valid function, then an undefined abbreviation. The old nil-entry-first
+	// reader loop could silently publish the earlier symbol and negative facts.
+	abbrev := []byte{1, 0x11, 1, 0, 0, 2, 0x2e, 0, 0x6e, 8, 0, 0, 0}
+	body := []byte{4, 0, 0, 0, 0, 0, 8, 1, 2}
+	body = append(body, []byte("_ZN8smallvec8SmallVec4grow17h1234567890abcdefE")...)
+	body = append(body, 0, 3)
+	info := make([]byte, 4)
+	binary.LittleEndian.PutUint32(info, uint32(len(body)))
+	info = append(info, body...)
+	data, err := dwarf.New(abbrev, nil, nil, info, nil, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := functionsFromDebugData(data); err == nil {
+		t.Fatal("truncated debug after valid symbol was admitted")
+	}
+}
