+	binaryData, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bundle, err := filepath.EvalSymlinks(path + ".dSYM")
+	if err != nil {
+		t.Fatal(err)
+	}
+	entries, err := os.ReadDir(filepath.Join(bundle, "Contents/Resources/DWARF"))
+	if err != nil || len(entries) != 1 {
+		t.Fatal("expected fixture dSYM")
+	}
+	debugData, err := os.ReadFile(filepath.Join(bundle, "Contents/Resources/DWARF", entries[0].Name()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	mf, err := macho.NewFile(bytes.NewReader(debugData))
+	if err != nil {
+		t.Fatal(err)
+	}
+	uuid := machoUUID(mf)
+	marker := append([]byte{0x1b, 0, 0, 0, 24, 0, 0, 0}, uuid...)
+	offset := bytes.Index(debugData, marker)
+	if offset < 0 {
+		t.Fatal("UUID load missing")
+	}
+	for _, mode := range []string{"wrong-uuid", "duplicate-uuid"} {
+		t.Run(mode, func(t *testing.T) {
+			target := filepath.Join(t.TempDir(), "fixture")
+			if err := os.WriteFile(target, binaryData, 0600); err != nil {
+				t.Fatal(err)
+			}
+			dir := target + ".dSYM/Contents/Resources/DWARF"
+			if err := os.MkdirAll(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			data := append([]byte{}, debugData...)
+			if mode == "wrong-uuid" {
+				data[offset+8] ^= 0xff
+			}
+			if err := os.WriteFile(filepath.Join(dir, "a"), data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			if mode == "duplicate-uuid" {
+				if err := os.WriteFile(filepath.Join(dir, "b"), data, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, err := functionsFromDWARFPath(bytes.NewReader(binaryData), target); err == nil {
+				t.Fatal("invalid UUID ownership admitted")
+			}
+		})
+	}
+}
