{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openidea:laravel:generators:v1",
  "title": "OpenIDEA Laravel native generators",
  "description": "Version 1 project or user generator definitions. Project config is .openidea/laravel-generators.json; templates are relative to .openidea/laravel-templates. Duplicate ids/names, choice-default membership, template existence, aggregate limits and calculations are additionally validated by the plugin. No template expression executes PHP or shell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "version": {
      "const": 1
    },
    "presets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "partials": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "description": "Registered shared template filenames relative to the template root. Native ${#include name} can only include registered or direct template files in its own project/user scope."
    },
    "generators": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blade-component": {
          "$ref": "#/$defs/generatorOptions"
        },
        "cast": {
          "$ref": "#/$defs/generatorOptions"
        },
        "channel": {
          "$ref": "#/$defs/generatorOptions"
        },
        "class": {
          "$ref": "#/$defs/generatorOptions"
        },
        "command": {
          "$ref": "#/$defs/generatorOptions"
        },
        "controller": {
          "$ref": "#/$defs/generatorOptions"
        },
        "dusk-component": {
          "$ref": "#/$defs/generatorOptions"
        },
        "dusk-page": {
          "$ref": "#/$defs/generatorOptions"
        },
        "dusk-test": {
          "$ref": "#/$defs/generatorOptions"
        },
        "enum": {
          "$ref": "#/$defs/generatorOptions"
        },
        "event": {
          "$ref": "#/$defs/generatorOptions"
        },
        "exception": {
          "$ref": "#/$defs/generatorOptions"
        },
        "facade": {
          "$ref": "#/$defs/generatorOptions"
        },
        "factory": {
          "$ref": "#/$defs/generatorOptions"
        },
        "feature-test": {
          "$ref": "#/$defs/generatorOptions"
        },
        "filament-relation-manager": {
          "$ref": "#/$defs/packageGeneratorOptions",
          "not": {
            "anyOf": [
              {
                "required": [
                  "separate"
                ]
              }
            ]
          }
        },
        "filament-resource": {
          "$ref": "#/$defs/packageGeneratorOptions"
        },
        "filament-schema": {
          "$ref": "#/$defs/packageGeneratorOptions",
          "not": {
            "anyOf": [
              {
                "required": [
                  "separate"
                ]
              },
              {
                "required": [
                  "baseClass"
                ]
              }
            ]
          }
        },
        "filament-table": {
          "$ref": "#/$defs/packageGeneratorOptions",
          "not": {
            "anyOf": [
              {
                "required": [
                  "separate"
                ]
              },
              {
                "required": [
                  "baseClass"
                ]
              }
            ]
          }
        },
        "http-exception": {
          "$ref": "#/$defs/generatorOptions"
        },
        "interface": {
          "$ref": "#/$defs/generatorOptions"
        },
        "job": {
          "$ref": "#/$defs/generatorOptions"
        },
        "listener": {
          "$ref": "#/$defs/generatorOptions"
        },
        "livewire-component": {
          "$ref": "#/$defs/generatorOptions"
        },
        "livewire-form": {
          "$ref": "#/$defs/generatorOptions"
        },
        "mail": {
          "$ref": "#/$defs/generatorOptions"
        },
        "middleware": {
          "$ref": "#/$defs/generatorOptions"
        },
        "migration": {
          "$ref": "#/$defs/generatorOptions"
        },
        "model": {
          "$ref": "#/$defs/generatorOptions"
        },
        "notification": {
          "$ref": "#/$defs/generatorOptions"
        },
        "nova-resource": {
          "$ref": "#/$defs/packageGeneratorOptions",
          "not": {
            "anyOf": [
              {
                "required": [
                  "separate"
                ]
              }
            ]
          }
        },
        "observer": {
          "$ref": "#/$defs/generatorOptions"
        },
        "policy": {
          "$ref": "#/$defs/generatorOptions"
        },
        "provider": {
          "$ref": "#/$defs/generatorOptions"
        },
        "request": {
          "$ref": "#/$defs/generatorOptions"
        },
        "resource": {
          "$ref": "#/$defs/generatorOptions"
        },
        "resource-collection": {
          "$ref": "#/$defs/generatorOptions"
        },
        "resource-controller": {
          "$ref": "#/$defs/generatorOptions"
        },
        "rule": {
          "$ref": "#/$defs/generatorOptions"
        },
        "scope": {
          "$ref": "#/$defs/generatorOptions"
        },
        "seeder": {
          "$ref": "#/$defs/generatorOptions"
        },
        "service": {
          "$ref": "#/$defs/generatorOptions"
        },
        "tenant-migration": {
          "$ref": "#/$defs/generatorOptions"
        },
        "trait": {
          "$ref": "#/$defs/generatorOptions"
        },
        "unit-test": {
          "$ref": "#/$defs/generatorOptions"
        },
        "view": {
          "$ref": "#/$defs/generatorOptions"
        },
        "view-composer": {
          "$ref": "#/$defs/generatorOptions"
        },
        "inertia-page": {
          "$ref": "#/$defs/generatorOptions"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "migrationRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "viewRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "testRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "testNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "allowApplication": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 96
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "type": {
          "enum": [
            "text",
            "boolean",
            "choice",
            "model"
          ]
        },
        "choices": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "default": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "minItems": 1
              },
              "default": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "choices": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "model"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\\\*[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          }
        }
      ]
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 96
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "calculated": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "expression"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 96
              },
              "expression": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^\\$\\{[^{}]*\\}$",
                "description": "One expression consuming an input, CURRENT_TIME or earlier calculation. Supports bounded case, trim/replace/prefix/suffix, class/FQN helpers, inflection, PHP literals and UTC SimpleDateFormat date patterns; see schemas/README.md. Escape pipes inside arguments as \\|."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "hidden": {
                "type": "boolean",
                "default": false,
                "description": "Compute without displaying a field; hidden values cannot be overridden."
              },
              "editable": {
                "type": "boolean",
                "default": true,
                "description": "Visible calculated values may be overridden until reset to automatic. False makes the field read-only."
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "template"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Output path template. Expanded path must be relative and contain no . or .. components."
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              }
            }
          }
        },
        "availableInApplication": {
          "type": "boolean",
          "default": true
        },
        "availableInModules": {
          "type": "boolean",
          "default": true
        },
        "moduleIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 96
          },
          "description": "When supplied, only these configured modules can invoke the preset. Application availability is independent."
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "namespace",
        "sourceRoot",
        "migrationRoot",
        "viewRoot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 96
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\\\*[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "migrationRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "viewRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "factoryRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "description": "Explicit module related-file project-relative root; omitted values derive from the module namespace and database directory."
        },
        "factoryNamespace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "description": "Explicit module related-file namespace; omitted values derive from the module namespace and database directory."
        },
        "seederRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "description": "Explicit module related-file project-relative root; omitted values derive from the module namespace and database directory."
        },
        "seederNamespace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "description": "Explicit module related-file namespace; omitted values derive from the module namespace and database directory."
        },
        "generators": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blade-component": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "cast": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "channel": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "class": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "command": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "controller": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "dusk-component": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "dusk-page": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "dusk-test": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "enum": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "event": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "exception": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "facade": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "factory": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "feature-test": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "filament-relation-manager": {
              "$ref": "#/$defs/modulePackageGeneratorOptions",
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "separate"
                    ]
                  }
                ]
              }
            },
            "filament-resource": {
              "$ref": "#/$defs/modulePackageGeneratorOptions"
            },
            "filament-schema": {
              "$ref": "#/$defs/modulePackageGeneratorOptions",
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "separate"
                    ]
                  },
                  {
                    "required": [
                      "baseClass"
                    ]
                  }
                ]
              }
            },
            "filament-table": {
              "$ref": "#/$defs/modulePackageGeneratorOptions",
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "separate"
                    ]
                  },
                  {
                    "required": [
                      "baseClass"
                    ]
                  }
                ]
              }
            },
            "http-exception": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "interface": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "job": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "listener": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "livewire-component": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "livewire-form": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "mail": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "middleware": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "migration": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "model": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "notification": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "nova-resource": {
              "$ref": "#/$defs/modulePackageGeneratorOptions",
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "separate"
                    ]
                  }
                ]
              }
            },
            "observer": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "policy": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "provider": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "request": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "resource": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "resource-collection": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "resource-controller": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "rule": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "scope": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "seeder": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "service": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "tenant-migration": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "trait": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "unit-test": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "view": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "view-composer": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            },
            "inertia-page": {
              "$ref": "#/$defs/moduleGeneratorOptions"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Database\\Eloquent\\Model"
        },
        "controllerBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Routing\\Controller"
        },
        "requestBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Foundation\\Http\\FormRequest"
        },
        "resourceBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Http\\Resources\\Json\\JsonResource"
        },
        "factoryBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Database\\Eloquent\\Factories\\Factory"
        },
        "seederBase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "default": "Illuminate\\Database\\Seeder"
        },
        "policyBase": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "controllerPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Controller",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "policyPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Policy",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "requestPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Request",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "resourcePostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Resource",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "factoryPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Factory",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "seederPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": "Seeder",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "typeHints": {
          "type": "boolean",
          "default": true,
          "description": "Emit generated return type declarations; dependency parameter types remain necessary for container injection."
        },
        "constructorPromotion": {
          "type": "boolean",
          "default": true
        },
        "controllerDependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "class"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "modelPostfix": {
          "type": "string",
          "maxLength": 96,
          "default": ""
        }
      }
    },
    "generatorOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Project-relative native output directory. Optional ${sourceRoot} and ${moduleRoot} placeholders resolve in the selected context."
        },
        "namespace": {
