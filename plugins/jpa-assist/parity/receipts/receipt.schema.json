{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JPA Assist acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "rows", "host", "fixture", "result", "observations", "artifacts", "checks", "tester", "date"],
  "properties": {
    "example": {"type": "boolean", "description": "true marks a documentation example; ignored for coverage"},
    "scenario": {"type": "string", "pattern": "^AC-[0-9]{3}$"},
    "rows": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][0-9]{3}$"}, "uniqueItems": true},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "os", "pluginBuild"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "pluginBuild": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of dist/plugin.wasm"}
      }
    },
    "fixture": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "blocked"]},
    "observations": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "description": "relative to the receipts directory"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_matches", "undo_exact", "cancel_clean", "stale_refused", "crlf_ok"],
      "properties": {
        "preview_matches": {"enum": ["pass", "fail", "n/a"]},
        "undo_exact": {"enum": ["pass", "fail", "n/a"]},
        "cancel_clean": {"enum": ["pass", "fail", "n/a"]},
        "stale_refused": {"enum": ["pass", "fail", "n/a"]},
        "crlf_ok": {"enum": ["pass", "fail", "n/a"]}
      }
    },
    "tester": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
