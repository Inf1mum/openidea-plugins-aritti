        }
      },
      {
        "operation": {
          "kind": "reverse-inventory",
          "path": "$PROJECT/db/ghost.sql",
          "dialect": null,
          "schema": null,
          "table": "child"
        }
      }
    ]
  },
  "expect": {
    "designerReplies": [
      {
        "path": "reverse.selected.references",
        "message": 2,
        "length": 1
      },
      {
        "path": "reverse.selected.references.0.columnPresent",
        "message": 2,
        "equals": false
      },
      {
        "path": "reverse.selected.references.0.refTable",
        "message": 2,
        "equals": "parent"
      }
    ]
