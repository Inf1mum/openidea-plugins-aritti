  "verifies": {
    "G116-C5": "with liquibaseStringTypes rows (postgresql: varchar, mssql: nvarchar) the generated changelog declares one <property name=\"string.type\" value=... dbms=.../> per row and writes the varchar column as ${string.type}(n), so one changelog serves both DBMS. Only string.type is generated (the docs show no other property), the DBMS list is whatever the rows name, and Liquibase itself is not run to check the substitution."
  },
  "fixture": "envers-flyway-liquibase",
  "kind": "fileaction",
