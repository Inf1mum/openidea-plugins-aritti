  "target": {
    "file": "src/main/java/com/example/shop/repository/CustomerRepository.java",
    "anchor": "interface CustomerRepository"
  },
  "action": {
    "title": "Convert derived query to @Query\u2026"
  },
  "prompts": [
    {
      "pick": "findByVersion"
    },
    {
      "input": "findByVersion"
    },
    {
      "confirm": "yes"
    }
  ],
  "expect": {
    "resultFile": {
      "path": "src/main/java/com/example/shop/repository/CustomerRepository.java",
      "matches": [
        "@Query\\(\"select \\w+ from Customer \\w+ where \\w+\\.version = :version\"\\)\\s+Optional<Customer>\\s+findByVersion\\(@Param\\(\"version\"\\) long version\\)"
