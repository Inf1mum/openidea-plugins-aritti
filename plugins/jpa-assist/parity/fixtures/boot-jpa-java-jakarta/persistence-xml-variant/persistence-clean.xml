<?xml version="1.0" encoding="UTF-8"?>
<!-- Clean variant. Swap in: copy to src/main/resources/META-INF/persistence.xml (renamed there) (see README). -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="shopPu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.example.shop.domain.Customer</class>
        <class>com.example.shop.domain.CustomerOrder</class>
        <class>com.example.shop.domain.Product</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/shop"/>
            <property name="jakarta.persistence.jdbc.user" value="shop"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
        </properties>
    </persistence-unit>
</persistence>
