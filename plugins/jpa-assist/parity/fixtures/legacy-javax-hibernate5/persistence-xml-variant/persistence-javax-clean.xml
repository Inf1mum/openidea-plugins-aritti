<?xml version="1.0" encoding="UTF-8"?>
<!-- Clean javax (JPA 2.2) variant. Swap in: copy to src/main/resources/META-INF/persistence.xml (renamed there). -->
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
    <persistence-unit name="libraryPu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <mapping-file>META-INF/orm.xml</mapping-file>
        <class>com.example.library.domain.Author</class>
        <class>com.example.library.domain.Book</class>
        <class>com.example.library.domain.Publisher</class>
        <class>com.example.library.domain.Tag</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:mem:library"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
